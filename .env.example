# Port aplikasi (untuk Docker: port di host yang di-map ke container)
PORT=3000

# Lokasi database SQLite (di Docker selalu /app/data)
DATA_DIR=./data

# User awal, HANYA dipakai saat database masih kosong (pertama kali jalan).
# Setelah itu ganti password lewat menu "Ganti Password" di dashboard.
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=12345678

# Jika diisi, request ke /api/receive wajib membawa header "x-api-key: <nilai ini>"
RECEIVE_API_KEY=

# Batas ukuran body yang diterima /api/receive
BODY_LIMIT=10mb

# Set true jika aplikasi diakses lewat HTTPS
COOKIE_SECURE=false

# Set true jika berada di belakang reverse proxy (nginx, traefik, dll) agar IP asli tercatat
TRUST_PROXY=false
